# Demo profiles work only in local development, never in production.
AUTH_MODE=demo
# Empty means browser-only demo storage. Set to use PostgreSQL.
DATABASE_URL=
# Local compose URL: postgresql://sprout:sprout-local-only@localhost:5438/sprout

# Real login: AUTH_MODE=workos, DATABASE_URL, and all fields below.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
